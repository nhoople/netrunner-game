{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*", "tests/**/*"],
  // Each has its own tsconfig with bundler resolution and DOM libs, not this
  // NodeNext config: tests/browser (typecheck:browser), and tests/client,
  // which imports client source and so uses the product client's settings
  // (typecheck:client).
  "exclude": ["tests/browser", "tests/client"]
}
