{
  "name": "netrunner-game",
  "version": "0.0.1",
  "private": true,
  "description": "Netrunner game host. Plays through netrunner-engine and pinned card and Comprehensive Rules data.",
  "type": "module",
  "scripts": {
    "fetch-engine": "node scripts/fetch-engine.mjs",
    "build:engine": "npm install --prefix deps/netrunner-engine && npm run build --prefix deps/netrunner-engine",
    "fetch-data": "node scripts/fetch-data.mjs",
    "check": "tsx src/check.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:client": "tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p tests/client/tsconfig.json",
    "typecheck:browser": "tsc --noEmit -p tests/browser/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "build:client": "vite build --config client/vite.config.ts",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:browser": "npm run build:client && playwright test",
    "fuzz:visibility": "tsx scripts/visibility-fuzz.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "netrunner-engine": "file:./deps/netrunner-engine",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.20.0",
    "globals": "^17.14.0",
    "knip": "^6.46.1",
    "prettier": "^3.10.1",
    "solid-js": "^1.9.18",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "qs": "^6.16.1"
  }
}
