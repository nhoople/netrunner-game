{
  "name": "netrunner-game",
  "version": "0.0.1",
  "private": true,
  "description": "Netrunner game host. Plays through netrunner-engine and pinned card and Comprehensive Rules data.",
  "type": "module",
  "scripts": {
    "fetch-engine": "node scripts/fetch-engine.mjs",
    "build:engine": "npm install --prefix deps/netrunner-engine && npm run build --prefix deps/netrunner-engine",
    "fetch-data": "node scripts/fetch-data.mjs",
    "fetch-images": "tsx scripts/fetch-images.ts",
    "check": "tsx src/check.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:client": "tsc --noEmit -p client/tsconfig.json",
    "build:client": "vite build --config client/vite.config.ts",
    "test": "tsx --test src/*.test.ts client/src/*.test.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "netrunner-engine": "file:./deps/netrunner-engine",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.1",
    "solid-js": "^1.9.18",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15"
  }
}
